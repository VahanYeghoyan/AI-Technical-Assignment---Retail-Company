# Copy to .env and edit.  .env is gitignored — never commit real keys.

# --- Google Cloud project ---
# The project that BigQuery jobs and Vertex AI calls run in (and bill to).
# Leave it commented out to use the one from `gcloud config set project`;
# uncomment only to override that.
# GOOGLE_CLOUD_PROJECT=your-project-id

# --- Model backend ---
#   vertex  Vertex AI via Application Default Credentials — NO API KEY NEEDED.
#           Reuses the same gcloud credentials BigQuery already requires, and
#           bills through your GCP project. Recommended: AI Studio keys have a
#           small free tier that returns 429 on every model once exhausted.
#           Needs a project with billing enabled, and
#           `gcloud services enable aiplatform.googleapis.com`.
#   gemini  Google AI Studio API key (set GOOGLE_API_KEY below). Use this with a
#           BigQuery sandbox project, which has no billing account for Vertex.
#   stub    Fully offline scripted demo: no network, no credentials, no quota.
#           Shows the SQL guard, report library and deletion confirmation flow.
LLM_PROVIDER=vertex
VERTEX_LOCATION=global

# Only for LLM_PROVIDER=gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-key-here

# Model IDs verified against the AI Studio model listing on 2026-09-18 and live
# on Vertex AI (location global) on 2026-09-22. gemini-2.5-* are retired for new
# keys; the API itself redirects to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- BigQuery ---
# Hard cost ceiling per query. Every query is dry-run first and rejected if it
# would scan more than this. 2 GB is ~100x the largest table in thelook.
BQ_MAX_BYTES_BILLED=2000000000
BQ_QUERY_TIMEOUT_S=60

# --- Agent ---
# Which executive persona the CLI logs in as (see config/entitlements.yaml).
AGENT_USER=maya
# Stable salt for customer pseudonymisation. Change it and the CUST-xxxx ids change.
PSEUDONYM_SALT=change-me-in-production
