# Copy to .env and fill in.  .env is gitignored — never commit real keys.

# --- Gemini (Google AI Studio) ---
GOOGLE_API_KEY=your-key-here
# Model IDs verified against the live /v1beta/models listing on 2026-09-18.
# gemini-2.5-* are retired for new keys; the API itself redirects to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Which model backend to use:
#   vertex  Vertex AI via Application Default Credentials — NO API KEY NEEDED.
#           Reuses the same gcloud credentials BigQuery already requires, and
#           bills through your GCP project. Recommended: AI Studio keys have a
#           small free tier that returns 429 on every model once exhausted.
#           Needs: gcloud services enable aiplatform.googleapis.com
#   gemini  AI Studio API key (set GOOGLE_API_KEY below).
#   stub    Fully offline, deterministic fake model. No network, no quota —
#           used by the test suite and for demoing the safety layers.
LLM_PROVIDER=vertex
VERTEX_LOCATION=global

# --- BigQuery ---
GOOGLE_CLOUD_PROJECT=assessment-for-opsfleet
# Hard cost ceiling per query. Every query is dry-run first and rejected if it
# would scan more than this. 2 GB is ~100x the largest table in thelook.
BQ_MAX_BYTES_BILLED=2000000000
BQ_QUERY_TIMEOUT_S=60

# --- Agent ---
# Which executive persona the CLI logs in as (see config/entitlements.yaml).
AGENT_USER=maya
# Stable salt for customer pseudonymisation. Change it and the CUST-xxxx ids change.
PSEUDONYM_SALT=change-me-in-production
